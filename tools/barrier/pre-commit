#!/usr/bin/env bash
# Barrier: no private data in what is added, nor in the author or the committer.
set -u
. "$(dirname "$0")/comun.sh"
for q in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
  h=$(with_data "$q"); [ -n "$h" ] && fail "identity with forbidden data: $h"
done
added=$(git diff --cached -U0 --no-color --no-ext-diff | grep -E '^(\+|diff --git)' | grep -v '^+++ ')
h=$(with_data "$added"); [ -n "$h" ] && fail "what is added contains: $h"
finish pre-commit
