#!/usr/bin/env bash
# Barrera: hacia CUALQUIER remoto, revisa todos los commits que salen (identidad, mensaje, diff) y el árbol final.
# Repite lo de pre-commit a propósito: un commit hecho sin la barrera activa (--no-verify, otra PC) no sale igual.
set -u
. "$(dirname "$0")/comun.sh"
remoto="$1"
CERO=0000000000000000000000000000000000000000
while read -r lref lsha rref rsha; do
  [ -z "${lref:-}" ] && continue
  [ "$lsha" = "$CERO" ] && continue                      # borrar una rama remota: no publica nada
  for c in $(git rev-list "$lsha" --not --remotes="$remoto"); do
    corto=${c:0:9}
    h=$(con_dato "$(git log -1 --format='%an <%ae> | %cn <%ce>' "$c")"); [ -n "$h" ] && falla "$corto: identidad: $h"
    msj=$(git log -1 --format='%B' "$c")
    h=$(con_dato "$msj"); [ -n "$h" ] && falla "$corto: mensaje: $h"
    printf '%s' "$msj" | grep -qi 'Claude-Session' && falla "$corto: el mensaje lleva Claude-Session"
    h=$(con_dato "$(git show --format= -U0 --no-color --no-ext-diff "$c" | grep -E '^(\+|diff --git)')")
    [ -n "$h" ] && falla "$corto: el diff agrega: $h"
  done
  arbol=$(git grep -I -i -l -E "$PATRON" "$lsha" -- 2>/dev/null | head -5 | tr '\n' ' ')
  [ -n "$arbol" ] && falla "$lref: el árbol final tiene datos prohibidos en: $arbol"
done
terminar "pre-push a $remoto"
